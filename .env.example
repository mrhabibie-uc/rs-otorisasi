PORT=3000
# Ganti dengan string acak panjang, misalnya hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-acak
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Dari Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
